{
  "name": "complexipy",
  "displayName": "complexipy",
  "description": "Cognitive complexity for Python as you type: inlay hints, hover details, and warnings from the complexipy language server",
  "version": "0.3.0",
  "icon": "img/complexipy.png",
  "publisher": "rohaquinlop",
  "repository": {
    "type": "git",
    "url": "https://github.com/rohaquinlop/complexipy"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Testing"
  ],
  "activationEvents": [
    "onLanguage:python"
  ],
  "main": "./extension.js",
  "contributes": {
    "configuration": {
      "title": "complexipy",
      "properties": {
        "complexipy.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "Path to the `complexipy` executable. The extension runs `<path> lsp`. Leave empty to use `complexipy` from the `PATH`."
        }
      }
    }
  },
  "scripts": {
    "lint": "eslint .",
    "pretest": "npm run lint",
    "test": "node --test"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "16.x",
    "eslint": "^8.56.0"
  }
}
