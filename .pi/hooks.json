{
  "version": 1,
  "hooks": [
    {
      "id": "session-start",
      "event": "sessionStart",
      "command": ["sh", ".agents/hooks/session-start.sh"]
    },
    {
      "id": "quality-gate",
      "event": "postToolUse",
      "matcher": "write|edit|bash",
      "command": ["sh", ".pi/hook-scripts/turn-end.sh"],
      "timeoutMs": 1800000
    }
  ]
}
